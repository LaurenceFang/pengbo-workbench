{
  "name": "pengbo-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "web:build": "tsc -b && vite build",
    "build": "npm run web:build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "backend:dev": "py -m backend.app.cli --host 127.0.0.1 --port 8765 --runtime-mode web-dev --data-dir ./.pengbo-runtime/data --log-dir ./.pengbo-runtime/logs",
    "sidecar:build": "py scripts/build_sidecar.py --target x86_64-pc-windows-msvc",
    "smoke:packaged-startup": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_startup_smoke.ps1",
    "smoke:installed-startup": "powershell -ExecutionPolicy Bypass -File ./scripts/installed_bundle_startup_smoke.ps1",
    "smoke:installed-startup:nsis": "powershell -ExecutionPolicy Bypass -File ./scripts/installed_bundle_startup_smoke.ps1 -InstallerType nsis",
    "smoke:portfolio-offline": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_portfolio_offline_smoke.ps1",
    "smoke:portfolio-ui-signoff": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_portfolio_ui_signoff.ps1",
    "smoke:screener-variant-signoff": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_screener_variant_signoff.ps1",
    "smoke:research-workspace": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_research_workspace_smoke.ps1",
    "smoke:factor-lab": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_factor_lab_smoke.ps1",
    "smoke:strategy-lab": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_strategy_lab_smoke.ps1",
    "smoke:binance-execution": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_binance_execution_smoke.ps1",
    "smoke:evidence-report": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_evidence_report_smoke.ps1",
    "smoke:workflow-studio:packaged": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_workflow_studio_smoke.ps1",
    "smoke:data-sources:packaged": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_data_sources_smoke.ps1",
    "smoke:local-security:packaged": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_local_security_smoke.ps1",
    "smoke:workflow-studio": "node ./scripts/workflow_studio_smoke.mjs",
    "smoke:visual-design": "node ./scripts/visual_design_smoke.mjs",
    "smoke:page-polish": "node ./scripts/page_polish_smoke.mjs",
    "smoke:localization": "node ./scripts/localization_smoke.mjs",
    "check:i18n": "node ./scripts/i18n_check.mjs",
    "smoke:provider-capability-signoff": "powershell -ExecutionPolicy Bypass -File ./scripts/packaged_provider_capability_signoff.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/cli": "^2.10.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-stronghold": "^2.3.1",
    "lightweight-charts": "^4.2.3",
    "lucide-react": "^0.511.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "playwright": "^1.59.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.7"
  }
}
