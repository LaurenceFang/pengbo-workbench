{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pengbo desktop main capability",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "stronghold:default",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "pengbo-sidecar",
          "sidecar": true,
          "args": true
        },
        {
          "name": "python-sidecar-dev",
          "cmd": "py",
          "sidecar": false,
          "args": true
        }
      ]
    }
  ]
}
